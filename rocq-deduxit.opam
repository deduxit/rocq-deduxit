opam-version: "2.0"
version: "0.8.0"
synopsis: "The Rocq library of deduxit, a collection of logic suites"
description: """
The Rocq library that checks the certificates deduxit writes for the
proofs and refutations it finds. deduxit is a collection of logic
suites: ordinary logic (classical, intuitionistic and minimal), linear
logic, modal logic and lambda-terms. The library defines under
Deduxit.Intuitionistic the calculi of intuitionistic and minimal logic,
their Kripke models and a checker of finite countermodels, and their
first-order versions with classical logic, Kripke models with growing
domains, finite structures and checkers of both; under Deduxit.Linear
the sequent calculi of linear logic, a checker for deduxit's proof
terms, and the theorems that turn a checked term into a derivation; and
under Deduxit.Modal the modal systems from K to S5, their labelled
sequent calculus with its soundness for Kripke models, a checker of
labelled proofs and one of finite countermodels.

The library's definitions, proofs, tests and documentation, like deduxit's,
were written with substantial AI assistance, by Anthropic's Claude models
in Claude Code, in steps the author planned, directed and accepted.
"""
maintainer: "Fabian Lukas Grubmüller <flgrubm@grubmueller.dev>"
authors: "Fabian Lukas Grubmüller"
license: "EUPL-1.2"
homepage: "https://github.com/deduxit/rocq-deduxit"
bug-reports: "https://github.com/deduxit/rocq-deduxit/issues"
dev-repo: "git+https://github.com/deduxit/rocq-deduxit.git"
doc: "https://deduxit.github.io/rocq-deduxit/"
tags: [
  "logpath:Deduxit"
  "category:Mathematics/Logic"
  "keyword:intuitionistic logic"
  "keyword:first-order logic"
  "keyword:Kripke semantics"
  "keyword:linear logic"
  "keyword:modal logic"
  "keyword:sequent calculus"
  "date:2026-11-23"
]
depends: [
  "rocq-core" {>= "9.0" & < "9.4~"}
  "rocq-stdlib" {>= "9.0" & < "9.3~"}
]
build: [make "-j%{jobs}%"]
install: [make "install"]
