opam-version: "2.0"
version: "0.3.0"
synopsis: "The Rocq library of deduxit, a collection of logic suites"
description: """
Certificates for the proofs and refutations that deduxit, a prover of
classical and intuitionistic linear logic and of ordinary logic, finds:
the sequent calculi of linear logic in Rocq under Deduxit.Linear, against
which the scripts deduxit writes check every proof rule by rule.

The library's definitions, proofs, tests and documentation, like deduxit's,
were written with substantial AI assistance, by Anthropic's Claude models
in Claude Code, in steps the author planned, directed and accepted.
"""
maintainer: "Fabian Lukas Grubmüller <flgrubm@grubmueller.dev>"
authors: "Fabian Lukas Grubmüller"
license: "EUPL-1.2"
homepage: "https://github.com/deduxit/rocq-deduxit"
bug-reports: "https://github.com/deduxit/rocq-deduxit/issues"
dev-repo: "git+https://github.com/deduxit/rocq-deduxit.git"
doc: "https://deduxit.github.io/rocq-deduxit/"
tags: [
  "logpath:Deduxit"
  "category:Mathematics/Logic"
  "keyword:linear logic"
  "keyword:sequent calculus"
  "date:2026-11-09"
]
depends: [
  "rocq-core" {>= "9.0" & < "9.4~"}
  "rocq-stdlib" {>= "9.0"}
]
build: [make "-j%{jobs}%"]
install: [make "install"]
