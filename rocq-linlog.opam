# linlog © Fabian Lukas Grubmüller 2026
# Licensed under the EUPL

opam-version: "2.0"
version: "0.2.0"
synopsis: "The Rocq library of linlog, a linear logic suite"
description: """
Certificates for the proofs that linlog, a prover of classical and
intuitionistic linear logic, finds: a sequent calculus of linear logic in
Rocq, against which the scripts linlog writes check every proof rule by
rule.

The library's definitions, proofs, tests and documentation, like linlog's,
were written with substantial AI assistance, by Anthropic's Claude models
in Claude Code, in steps the author planned, directed and accepted.
"""
maintainer: "Fabian Lukas Grubmüller <flgrubm@grubmueller.dev>"
authors: "Fabian Lukas Grubmüller"
license: "EUPL-1.2"
homepage: "https://github.com/linlog-prover/rocq-linlog"
bug-reports: "https://github.com/linlog-prover/rocq-linlog/issues"
dev-repo: "git+https://github.com/linlog-prover/rocq-linlog.git"
doc: "https://linlog-prover.github.io/rocq-linlog/"
tags: [
  "logpath:Linlog"
  "category:Mathematics/Logic"
  "keyword:linear logic"
  "keyword:sequent calculus"
]
depends: [
  "rocq-core" {>= "9.0" & < "9.4~"}
  "rocq-stdlib" {>= "9.0"}
]
build: [make "-j%{jobs}%"]
install: [make "install"]
